package templates

templ ContactPage(csrfToken string) {
	@Base("Contact", csrfToken, contactContent(csrfToken))
}

templ contactContent(csrfToken string) {
	<section>
		<hgroup>
			<h1>Contact Us</h1>
			<p>We'd love to hear from you. Whether you're a veteran looking for support, someone who wants to help, or you just have questions about our mission, don't hesitate to reach out.</p>
		</hgroup>
	</section>
	<section class="grid">
		<article>
			<header>
				<h2>Send us a Message</h2>
			</header>
		<form method="post" action="/contact">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label for="name">
					Name *
					<input type="text" id="name" name="name" required/>
				</label>
				<label for="email">
					Email *
					<input type="email" id="email" name="email" required/>
				</label>
				<label for="phone">
					Phone (optional)
					<input type="tel" id="phone" name="phone"/>
				</label>
				<label for="message">
					Message *
					<textarea id="message" name="message" rows="6" required></textarea>
				</label>
				<button type="submit">Send Message</button>
			</form>
		</article>
		<article>
			<header>
				<h2>Get in Touch</h2>
			</header>
			<section>
				<h4>Email</h4>
				<p><a href="mailto:AmericanVeteransRebuilding@avrnpo.org">AmericanVeteransRebuilding@avrnpo.org</a></p>
			</section>
			<section>
				<h4>Follow Us</h4>
				<div class="grid social-links">
					<a href="https://discord.com/invite/f6TzKart7J" target="_blank" rel="noopener noreferrer" aria-label="Join us on Discord">
						<img src="/assets/images/Discord.svg" alt="Discord"/>
					</a>
					<a href="https://open.spotify.com/show/5BBarK2chVBVPCbqrILO73" target="_blank" rel="noopener noreferrer" aria-label="Listen to our Spotify podcast">
						<img src="/assets/images/Spotify.svg" alt="Spotify"/>
					</a>
					<a href="https://www.facebook.com/AmericanVeteransRebuilding" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook">
						<img src="/assets/images/Facebook.svg" alt="Facebook"/>
					</a>
					<a href="https://x.com/avrnpo" target="_blank" rel="noopener noreferrer" aria-label="Follow us on X">
						<img src="/assets/images/X.svg" alt="X"/>
					</a>
				</div>
			</section>
			<div class="info-section">
				<h4>For Veterans</h4>
				<p>
					If you're a veteran interested in our programs, please include your service information
					and what type of support you're looking for in your message.
				</p>
			</div>
			<div class="info-section">
				<h4>For Supporters</h4>
				<p>
					Interested in volunteering, donating, or partnering with us?
					Let us know how you'd like to contribute to our mission.
				</p>
			</div>
		</article>
	</section>
}

templ ContactSuccessPage(csrfToken string) {
	@Base("Message Sent", csrfToken, contactSuccessContent())
}

templ contactSuccessContent() {
	<section class="contact-result success">
		<div class="result-icon">✓</div>
		<h1>Thank You!</h1>
		<p class="result-message">Your message has been sent successfully.</p>
		<p class="text-muted">We'll get back to you soon.</p>
		<div class="result-actions">
			<a href="/" role="button" class="secondary">Return to Home</a>
		</div>
	</section>
}
