package templates

templ AboutPage(csrfToken string) {
	@Base("About Us", csrfToken, aboutContent())
}

templ aboutContent() {
	<article>
		<header>
			<h1>About American Veterans Rebuilding</h1>
		</header>
		<section>
			<h2>Our Mission</h2>
			<p>American Veterans Rebuilding is dedicated to supporting veterans in their journey home by providing assistance, resources, and community support.</p>
		</section>
		<section>
			<h2>What We Do</h2>
			<p>We provide a range of services to help veterans rebuild their lives after service:</p>
			<ul>
				<li>Housing assistance and support</li>
				<li>Employment resources and job placement</li>
				<li>Mental health and wellness programs</li>
				<li>Community building and peer support</li>
			</ul>
		</section>
		<section>
			<h2>Get Involved</h2>
			<p>There are many ways to support our mission:</p>
			<div class="grid">
				<div>
					<h3>Donate</h3>
					<p>Your financial support helps us provide critical services to veterans in need.</p>
					<a href="/donate" role="button">Donate Now</a>
				</div>
				<div>
					<h3>Contact Us</h3>
					<p>Have questions or want to learn more about our work?</p>
					<a href="/contact" role="button" class="secondary">Get in Touch</a>
				</div>
			</div>
		</section>
	</article>
}
