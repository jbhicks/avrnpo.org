package templates

type AdminPost struct {
	Id          string
	Slug        string
	Title       string
	Excerpt     string
	PublishedAt string
	Published   bool
}

templ AdminPostListPage(posts []AdminPost, csrfToken string) {
	@BasePage("Admin - Manage Posts", csrfToken, adminPostListContent(posts))
}

templ adminPostListContent(posts []AdminPost) {
	<div class="admin-container">
		<article class="admin-card">
			<div class="admin-header">
				<h1>Manage Posts</h1>
				<div class="admin-actions">
					<a href="/cms/posts/new" role="button" class="contrast">Create New Post</a>
					<a href="/" role="button" class="secondary">Back to Site</a>
					<button hx-post="/auth/logout" role="button" class="outline">Logout</button>
				</div>
			</div>
			if len(posts) == 0 {
				<p class="admin-empty">No posts yet. Create your first post!</p>
			} else {
				<div class="admin-table-wrapper">
					<table class="admin-table">
						<thead>
							<tr>
								<th>Title</th>
								<th>Status</th>
								<th>Published</th>
								<th class="admin-table-actions">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, post := range posts {
								<tr>
									<td>
										<div class="post-title">{ post.Title }</div>
										if post.Excerpt != "" {
											<div class="post-excerpt">{ post.Excerpt }</div>
										}
									</td>
									<td>
										if post.Published {
											<span class="status-badge published">Published</span>
										} else {
											<span class="status-badge draft">Draft</span>
										}
									</td>
									<td class="post-date">{ post.PublishedAt }</td>
									<td>
										<div class="post-actions">
											<a href={ templ.URL("/blog/" + post.Slug) } target="_blank">View</a>
											<a href={ templ.URL("/cms/posts/" + post.Id + "/edit") }>Edit</a>
											<button hx-delete={ "/cms/posts/" + post.Id } hx-confirm="Are you sure you want to delete this post?" hx-target="closest tr" hx-swap="outerHTML" class="delete-action">Delete</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</article>
	</div>
}
