package templates

type TeamMember struct {
	Name     string
	Title    string
	Image    string
	Bio      string
}

templ TeamPage(csrfToken string) {
	@BasePage("Meet the Team", csrfToken, teamContent())
}

templ teamContent() {
	<section class="team-intro">
		<h1>Meet The Team</h1>
		<p>
			The American Veterans Rebuilding team is made up of individuals who have served their country
			with honor and distinction. We are committed to helping veterans rebuild their lives according
			to the military's core values of loyalty, duty, respect, selfless service, honor, integrity and personal courage.
		</p>
	</section>
	<section class="team-members">
		<div class="grid">
			@TeamMemberCard(TeamMember{
				Name:  "Michael Price",
				Title: "Founder / President",
				Image: "/assets/images/michaelPrice.avif",
				Bio:   "Michael Price is the Founder and President of American Veterans Rebuilding. He is a father to his daughter Madeline and husband to his wife Jessica. Michael served in the U.S. Army as Active Duty Infantry from 2004 to 2007, forming a brotherhood with Sergio Rubio and Joshua Hicks during a combat tour in Ramadi. He later earned the 37F MOS and served until 2010 as a Psychological Operations Specialist. After separating from the Army in 2010, Michael founded American Veterans Renovations, where he has been improving homes. American Veterans Rebuilding represents the shared vision of the team.",
			})
			@TeamMemberCard(TeamMember{
				Name:  "Sergio Rubio",
				Title: "Executive VP",
				Image: "/assets/images/sergioRubio.avif",
				Bio:   "Sergio Rubio is a Registered Nurse with over six years of experience, currently working in the Emergency and Cardiac departments at Kaweah Delta in Southern California. He served his community during the COVID-19 pandemic. Sergio graduated from California State University, Bakersfield in 2018 with a bachelor's degree in Nursing. He served in the U.S. Army for nine years, achieving the rank of Staff Sergeant and completing two combat deployments in Iraq. Sergio brings his expertise to support the mission of American Veterans Rebuilding.",
			})
		</div>
		<div class="grid">
			@TeamMemberCard(TeamMember{
				Name:  "Joshua Hicks",
				Title: "VP / Secretary",
				Image: "/assets/images/joshuaHicks.avif",
				Bio:   "Joshua Hicks is a husband, father, and Army veteran who served from 2004 to 2009, including a combat deployment to Ramadi, Iraq, with Michael Price and Sergio Rubio. After the military, Joshua pursued a career in technology, working as a software engineer and currently serving as Lead Software Engineer. He is passionate about using his technical expertise to help veterans transition into meaningful careers in technology and contribute to AVR's mission of rebuilding veteran lives.",
			})
			@TeamMemberCard(TeamMember{
				Name:  "William Cuccurullo",
				Title: "Treasurer",
				Image: "/assets/images/williamCuccurullo.avif",
				Bio:   "William Cuccurullo serves as Treasurer for American Veterans Rebuilding. He brings extensive financial expertise and a commitment to ensuring the organization's resources are managed effectively to maximize impact for veterans. William's dedication to fiscal responsibility helps AVR maintain transparency and accountability in all its programs and operations.",
			})
		</div>
	</section>
}

templ TeamMemberCard(member TeamMember) {
	<article class="team-card">
		<header class="team-card-image">
			<img src={ member.Image } alt={ member.Name }/>
			<div class="team-card-overlay">
				<small>{ member.Title }</small>
				<h2>{ member.Name }</h2>
			</div>
		</header>
		<div class="team-card-content">
			<p>
				{ member.Bio }
			</p>
		</div>
	</article>
}
