					]
				}
			</script>
			<script src="https://unpkg.com/htmx.org@2.0.3"></script>
			<script src="/assets/js/application.js"></script>
			<script src="https://myhelcim.com/js/version2/helcim-pay.js"></script>
	</head>
	<body class="js-enabled">
